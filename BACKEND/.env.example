# ==============================================================================
# SatQuery-AI Backend Environment Variables
# ==============================================================================

# Server Port
PORT=7000
NODE_ENV=production

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/satquery?schema=public

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost

# JWT Authentication Secrets
JWT_SECRET=supersecretjwtkey_antarix_satquery_ai_2026
JWT_EXPIRES_IN=7d

# Socket.IO Secret Verification Key (matches frontend SOCKET_KEY)
SOCKET_KEY=bgvpit303269bgwb9nishant

# Downstream Agentic AI Gateway ML Service
ML_API_URL=http://agentic-ai-gateway:8000/api/v1/analyze/stream
ML_API_KEY=

# Cloudinary Storage Configuration (Optional - falls back if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
