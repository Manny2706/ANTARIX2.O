# ==============================================================================
# ANTARIX 2.O — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=7000
GATEWAY_PORT=8000
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=satquery

# ------------------------------------------------------------------------------
# 3. Agentic AI Gateway Configuration (LLM & Vision)
# ------------------------------------------------------------------------------
# Fill in your Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Optional OpenRouter fallback (get at https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Vision Model Backend
# "disabled" = runs text & metadata orchestration on CPU without GPU
# "local"    = loads Qwen2-VL local vision model (requires NVIDIA GPU / CUDA)
VLM_BACKEND=local
VLM_MODEL_ID=manny2706/satquery-qwen2vl-4bitQuantized
VLM_LOAD_ON_STARTUP=false
LOG_LEVEL=INFO
API_KEYS=

# ------------------------------------------------------------------------------
# 4. Backend Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=supersecretjwtkey_antarix_satquery_ai_2026
JWT_EXPIRES_IN=7d
SOCKET_KEY=bgvpit303269bgwb9nishant
DEFAULT_USER_ID=70fa21d1-c6c0-4766-a264-9c2d418352c2

# ------------------------------------------------------------------------------
# 5. Cloudinary Storage (Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
